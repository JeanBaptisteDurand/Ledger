{
  "name": "porte-de-sortie-dmk",
  "private": true,
  "version": "1.0.0",
  "description": "Le chemin Signer du brief : Signer Kit Ethereum + DMK (Speculos ou USB), et le wallet-cli de l'Agent Stack",
  "type": "commonjs",
  "scripts": {
    "sign": "node sign_typed_data.cjs",
    "wallet-cli": "wallet-cli",
