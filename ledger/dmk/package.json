    "@ledgerhq/device-management-kit": "1.9.1",
    "@ledgerhq/device-signer-kit-ethereum": "1.18.1",
    "@ledgerhq/device-transport-kit-node-hid": "1.0.1",
    "@ledgerhq/device-transport-kit-speculos": "1.2.1",
    "@ledgerhq/device-transport-kit-web-hid": "^1.2.4",
    "@ledgerhq/wallet-cli": "2.1.0",
    "@noble/hashes": "^1.8.0",
    "esbuild": "^0.24.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
